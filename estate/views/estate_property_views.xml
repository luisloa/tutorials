<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="estate_property_fields_view" model="ir.ui.view">
        <field name='name'>Properties</field>
        <field name='model'>estate.property</field>
        <field name='arch' type='xml'>
            <list string='Properties' create='true'>
                <field name="name" string='Title' width='200'/>
                <field name="postcode" string='Postcode' width='100'/>
                <field name="bedrooms" string='Bedrooms' width='100'/>
                <field name="living_area" string='Living Area (sqm)' width='150'/>
                <field name="expected_price" string='Expected Price' width='150'/>
                <field name="selling_price" string='Selling Price' width='150'/>
                <field name="date_availability" string='Available From' width='150'/>
                <field name="state" string='State' width='100'/>
                <field name='property_type_id' string='Type of Property' width='150'/>
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form.view</field>
        <field name='model'>estate.property</field>
        <field name='arch' type='xml'>
            
            <form string="My New House">
                <header>
                    <button name="button_sold" type="object" string="SOLD"/>
                    <button name="button_cancel" type="object" string="CANCEL"/>
                </header>
                <sheet>
                    <h1><field name='name' placeholder='Name of the haouse'/></h1>
                    <group>
                        <group>
                            <field name='tag_ids' widget="many2many_tags"/>
                            <br></br>
                            <field name="state" string='State'/>
                            <field name='property_type_id' string='Type of Property'/>
                            <field name='postcode' string='Postcode'/>
                            <field name='date_availability' string='Available From'/>
                        </group>

                        <group>
                            <field name='expected_price' string='Expected Price'/>
                            <field name="best_price" string='Best Offer' />
                            <field name='selling_price' string='Selling Price'/>
                        </group>
                    </group>
                        
                    <notebook>
                        <page name="description" string="Description">
                            <group>
                                <field name="description" string='Description'/>
                                <field name="bedrooms" string='Bedrooms'/>
                                <field name="living_area" string='Living Area (sqm)'/>
                                <field name="facades" string='Facades'/>
                                <field name="garage" string='Garage'/>
                                <field name="garden" string='Garden'/>
                                <field name="garden_area" string='Garden Area (sqm)'/>
                                <field name="garden_orientation" string='Garden Orientation'/>
                                <field name="total_area" string='Total Area(sqm)'/>
                            </group>
                        </page>
                                
                        <page name="offers" string="Offers">
                            <group name="name" string="string">
                                <field name="offer_ids" string='Offers'>
                                    <list string="Offer" create='true'>
                                        <field name="price" string='Price' width='150'/>
                                        <field name="validity" string='Validity (days)' width='150'/>
                                        <field name="date_deadline" string="Deadline" width='150'/>
                                        <field name="partner_id" string='Parther' width='150'/>

                                        <button name="button_accept_offer" type="object" icon="fa-check" width='25' color='green'/>
                                        <button name="button_refuse_offer" type="object" icon="fa-times" width='25' color='red'/>
                                        
                                        <field name="status" string='Status' width='150'/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page name="other_info" string="Other Info">
                            <group>
                                <field name="seller_id" string='Salesman'/>
                                <field name="buyer_id" string="Buyer" />
                            </group>
                        </page>
                      
                    </notebook>

                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string='Title'/>
                <field name="postcode" string='Postcode'/>
                <field name="expected_price" string='Expected Price'/>
                <field name="bedrooms" string='Bedrooms'/>
                <field name="living_area" string='Living Area'/>
                <field name="facades" string='Facades'/>
                <field name='property_type_id' string='Type of Property'/>

                <filter name="date_availability" string="Availability" date="date_availability" end_month='11'/>  
                
                <filter name='postcode' string="Postcode" context="{'group_by': 'postcode'}"/>
                
                
                <filter name="available_properties_b" 
                        string="Available Properties By Codepost" 
                        domain="['|', ('state', '=', 'new'), 
                                        ('state', '=', 'offer_received')]"/>

            </search>
        </field>
    </record>
    

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name='name'>estate.property.view</field>
        <field name='res_model'>estate.property</field>
        <field name='view_mode'>list,form</field>
        <field name="view_id" ref="estate_property_fields_view"/>
    </record>

    <record id="estate_property_types_action" model="ir.actions.act_window">
        <field name="name">estate.property.type.view</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

     <record id="estate_property_tag_action" model="ir.actions.act_window">
        <field name="name">estate.property.tag.view</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
     </record>
</odoo>